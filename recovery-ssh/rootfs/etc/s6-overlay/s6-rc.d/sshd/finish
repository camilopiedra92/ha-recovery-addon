#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Takes the container down when sshd dies, so the Supervisor sees the failure and
# its watchdog restarts the app instead of leaving a container with no SSH.
# ==============================================================================
readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"

bashio::log.info "SSH daemon exited with code ${exit_code_service} (signal ${exit_code_signal})"

if [[ "${exit_code_service}" -ne 0 && "${exit_code_service}" -ne 256 ]]; then
    echo "${exit_code_service}" >/run/s6-linux-init-container-results/exitcode
fi
exec /run/s6/basedir/bin/halt
